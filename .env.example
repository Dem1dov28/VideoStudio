# ─── OpenRouter (LLM — сцены, субтитры, заголовки) ──────────────────────────
# Получить ключ: https://openrouter.ai/keys
OPENROUTER_API_KEY=sk-or-v1-...

# Модель: любая с https://openrouter.ai/models
# Примеры:
#   openai/gpt-4o          — лучшее качество
#   openai/gpt-4o-mini     — быстрее и дешевле (~$0.001 за запрос)
#   meta-llama/llama-3.1-70b-instruct  — бесплатная!
OPENROUTER_MODEL=openai/gpt-4o-mini
# Для сценариев «Почему X?» — опционально gpt-4o (лучше достоверность фактов)
# OPENROUTER_SCENARIO_MODEL=openai/gpt-4o

OPENROUTER_BASE_URL=https://openrouter.ai/api/v1

# ─── HuggingFace (бесплатная генерация изображений) ──────────────────────────
# Модель: FLUX.1-schnell — быстрая, бесплатная, отличное качество
# Получить бесплатный токен: https://huggingface.co/settings/tokens
# Без токена работает, но с ограничением по скорости

# ─── OpenAI (только для DALL-E 3) — опционально ──────────────────────────────
# Нужен только если IMAGE_GEN_STRATEGY=dalle
OPENAI_API_KEY=

# ─── Генерация изображений ────────────────────────────────────────────────────
# "hf"      = HuggingFace FLUX.1-schnell (БЕСПЛАТНО, рекомендуется)
# "dalle"   = OpenAI DALL-E 3 (~$0.04/изображение, нужен OPENAI_API_KEY)
# "fastgen" = Playwright на fast-gen.ai (нужны FASTGEN_EMAIL/PASSWORD)
IMAGE_GEN_STRATEGY=hf

FASTGEN_EMAIL=your@email.com
FASTGEN_PASSWORD=your_password

# ─── Настройки видео ─────────────────────────────────────────────────────────
VIDEO_FORMAT=vertical
VIDEO_FPS=30
VIDEO_DURATION_PER_IMAGE=3
VIDEO_TRANSITION_DURATION=0.5
TTS_VOICE=ru-RU-SvetlanaNeural

# ─── Postiz (публикация) — только когда публикуешь ───────────────────────────
POSTIZ_API_KEY=your_postiz_api_key
POSTIZ_BASE_URL=https://api.postiz.com/public/v1
POSTIZ_TIKTOK_INTEGRATION_ID=
POSTIZ_INSTAGRAM_INTEGRATION_ID=
POSTIZ_YOUTUBE_INTEGRATION_ID=
POSTIZ_TELEGRAM_INTEGRATION_ID=

# ─── Планировщик ─────────────────────────────────────────────────────────────
SCHEDULER_CRON=0 10 * * *

# ─── Пути ─────────────────────────────────────────────────────────────────────
OUTPUT_DIR=output
MUSIC_DIR=music