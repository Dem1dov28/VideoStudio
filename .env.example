# OpenRouter (LLM)
OPENROUTER_API_KEY=
OPENROUTER_MODEL=openai/gpt-4o-mini
# Для «Почему X?» — gpt-4o даёт более достоверные факты (опционально)
# OPENROUTER_SCENARIO_MODEL=openai/gpt-4o
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1

# fast-gen.ai
FASTGEN_API_KEY=
# value из <select> на fast-gen.ai (можно и подпись, напр. "Nano Banana 2 - Flow")
FASTGEN_MODEL=GEM_PIX_2
FASTGEN_HEADLESS=false
FASTGEN_IMAGE_TIMEOUT=300
# Повторы при ошибке/таймауте FastGen (stills с референсами, в т.ч. multiclip)
FASTGEN_MAX_ATTEMPTS=8
# Полных перезапусков браузерного контекста FastGen при фатальной ошибке
FASTGEN_OUTER_RESTART_ATTEMPTS=5
# Вкладка Image в FastGen (картинки, в т.ч. mode 13). Видео в FastGen — по VIDEO_FORMAT (9:16 при vertical).
FASTGEN_ASPECT_RATIO=16:9
# Папка для скачиваний из FastGen без диалога (пусто = MyVideo/_fastgen_chrome_downloads). Пример macOS:
# FASTGEN_CHROME_DOWNLOAD_DIR=/Users/you/Downloads/FastGen
# Диалог Chrome «Укажите, где сайт может сохранять» (File System Access API) — по умолчанию отключён в автоматизации
# FASTGEN_BLOCK_FS_ACCESS_API=false
# Img2img: доля шума 0–1 (как в SD). ~0.2 = ближе к референсу (Mode 3 «Дома»). Пусто = не трогать UI.
# FASTGEN_IMG2IMG_STRENGTH=0.22

# HTTP: media_gen_api v2 (без Playwright). Публичный хост API: https://googler.fast-gen.ai (origin без /api).
# FASTGEN_HTTP_BASE_URL=https://googler.fast-gen.ai
# Тот же ключ, что FASTGEN_API_KEY → заголовок X-API-Key (см. OpenAPI security)
# FASTGEN_HTTP_AUTH_STYLE=api_key
# Пути по умолчанию уже /api/v2/images и /api/v2/videos; poll — /api/v2/videos/status/{operation_id}
# FASTGEN_HTTP_MEDIA_PROVIDER=google_fx
# Большие рефы: загрузка на storage (по умолчанию https://storage.fast-gen.ai)
# FASTGEN_STORAGE_BASE_URL=https://storage.fast-gen.ai
# Видео v4: по умолчанию Veo Flow (текст и рефы); Flower только после N попыток Flow в Mode 4.
# FASTGEN_HTTP_V4_FLOW_FROM_TEXT_PATH=/api/v4/flow/video/from-text
# Отключить v4 и оставить только v2 legacy: FASTGEN_HTTP_ENABLE_V4_VIDEO=false
# FASTGEN_HTTP_ENABLE_V4_VIDEO=true
# Доп. поля: v2 — в parameters через FASTGEN_HTTP_EXTRA_JSON; v4 — тот же ключ сливается в корень тела POST.
# FASTGEN_HTTP_EXTRA_JSON={"seed":12345}
# FASTGEN_HTTP_POLL_DONE_VALUES=success
# FASTGEN_HTTP_POLL_FAILED_VALUES=error
#
# Режим 5: зацикленное motion-видео на блок (~30 мин) вместо смены JPEG каждые ~30 с — нужен FASTGEN_HTTP_BASE_URL выше.
# MODE5_BLOCK_LOOP_VIDEO_ENABLED=true
# MODE5_BLOCK_LOOP_SECONDS=1800
# MODE5_BLOCK_LOOP_STILL_THEN_ANIMATE=true
# Разрешение финального рендера Mode 5 (720 | 1080), независимо от VIDEO_QUALITY
# MODE5_VIDEO_QUALITY=1080
# Два клипа на блок (A: still→motion, B: последний кадр A→still) + HQ-склейка ffmpeg
# MODE5_BLOCK_LOOP_TWO_PART_LOOP=true
# MODE5_BLOCK_LOOP_CONCAT_CRF=17
# MODE5_BLOCK_LOOP_CONCAT_PRESET=slow

# Стратегия генерации изображений
IMAGE_GEN_STRATEGY=fastgen

# Резервные провайдеры (оставь пустыми если не нужны)
HF_TOKEN=
OPENAI_API_KEY=

# Видео
VIDEO_FORMAT=vertical
VIDEO_QUALITY=720
VIDEO_FPS=24
VIDEO_DURATION_PER_IMAGE=3
VIDEO_TRANSITION_DURATION=0.5
# moviepy = один проход; xfade = FFmpeg (slideleft/zoomin/…), нужен ffmpeg, дольше
# ffmpeg: сначала PATH и FFMPEG_PATH; иначе бинарник из imageio-ffmpeg (с moviepy). Явный путь:
# FFMPEG_PATH=C:/ffmpeg/bin/ffmpeg.exe
# macOS (Homebrew): Apple Silicon — /opt/homebrew/bin/ffmpeg, Intel — /usr/local/bin/ffmpeg
# Режим 13 / Whisper (опционально)
# WHISPER_MODEL_SIZE=medium
# WHISPER_DOWNLOAD_ROOT=D:/path/to/MyVideo/_whisper_models
# Параллелизм mode 13 (качество выхода тот же; выше — быстрее, но больше нагрузка на CPU/RAM/API)
# MODE13_PROMPT_LLM_CONCURRENCY=6
# MODE13_IMAGE_GEN_CONCURRENCY=3
# MODE13_PREVIEW_MP4_WORKERS=4
# Сколько сегментов в одном LLM-запросе для брифа картинки (12 по умолчанию; 1 = как раньше, по сегменту)
# MODE13_SCENE_BRIEF_BATCH_SIZE=12
# Экстренно ускорить за счёт качества брифа: без LLM для сцены (риск «книга с текстом»)
# MODE13_SCENE_BRIEF_SKIP_LLM=false
# Рендер mode 13: horizontal (1280×720) или vertical — не зависит от VIDEO_FORMAT
# MODE13_VIDEO_FORMAT=horizontal
# AI cleanup для плохих озвучек: модель FFmpeg arnndn (.rnnn). Если не указать, код попробует найти её
# автоматически в models/arnndn/*.rnnn, arnndn-models/*.rnnn или в корне проекта.
# MODE13_ARNNDN_MODEL_PATH=D:/Proga/Startups/VideoEditor/models/arnndn/std.rnnn
# VIDEO_TRANSITION_ENGINE=xfade
# VIDEO_TRANSITION_STYLES=slideleft,zoomin,smoothleft
# SUBTITLE_KARAOKE=true
# Сдвиг пословных таймкодов Whisper (сек), если караоке стабильно опережает/отстаёт: например 0.08 или -0.05
# SUBTITLE_WHISPER_TIME_SHIFT_SEC=0
# Начало слова чуть раньше (сек), чтобы подсветка не отставала; 0 = отключить. По умолчанию в config ~0.06
# SUBTITLE_WHISPER_WORD_START_LEAD_SEC=0.06
# Mode 4 (цитаты): масштаб шрифта субтитров/подписи. 1.0 = базовый, 1.6 = заметно крупнее.
# MODE4_QUOTE_SUBTITLE_SCALE=1.6
# Озвучка только VoiceAPI (голос — только через VOICEAPI_TEMPLATE_UUID в шаблоне бота)
# Mode 5: vertical | horizontal (по умолчанию vertical, как Shorts). Горизонталь по умолчанию только у mode 13 — см. MODE13_VIDEO_FORMAT
# MODE5_VIDEO_FORMAT=horizontal
# Mode 5 motion: false = статично (без «твича»), true = очень медленный zoom
# MODE5_ENABLE_ZOOM=false
# «50 фактов»: один замороженный кадр на факт (без zoompan), быстрее рендер
# MODE5_FACTS50_STATIC_STILL=true
# «50 фактов»: сколько фактов параллельно (TTS + картинки); при 429 от API уменьшите
# MODE5_FACTS50_PARALLEL=10
# Mode 5 transition (сек): мягкое растворение между кадрами
# MODE5_TRANSITION_SEC=0.7
# После фактов: sleep-tail (фоновая музыка + картинки). По умолчанию выключено (0).
# Чтобы включить, например 3600 = 1 час: MODE5_FACTS50_SLEEP_TAIL_SEC=3600
# MODE5_FACTS50_SLEEP_TAIL_SEC=0
# Громкость sleep-tail (0..1)
# MODE5_FACTS50_SLEEP_TAIL_VOLUME=0.34
# Смена картинки в sleep-tail (сек), 300 = каждые 5 минут
# MODE5_FACTS50_SLEEP_TAIL_IMAGE_INTERVAL_SEC=300
# VoiceAPI (csv666) TTS — обязательные поля
VOICEAPI_API_KEY=
VOICEAPI_BASE_URL=https://voiceapi.csv666.ru
# Анти-429 для VoiceAPI (/tasks): ограничение параллелизма и retry/backoff
# VOICEAPI_MAX_CONCURRENCY=3
# VOICEAPI_CREATE_MAX_ATTEMPTS=6
# VOICEAPI_RETRY_BASE_SEC=2.0
# VOICEAPI_RETRY_MAX_SEC=30.0
# Голос настраивается только в шаблоне VoiceAPI
VOICEAPI_TEMPLATE_UUID=
# Режим 2 (Почему X?): стоковое видео с Pexels — https://www.pexels.com/api/
PEXELS_API_KEY=

# ── Концепция канала ─────────────────────────────────────────────────────────
CHANNEL_CONCEPT=izlom

# ── Проверка фактов ───────────────────────────────────────────────────────────
# Проверять научную точность каждой сцены перед рендером (true/false)
USE_FACT_CHECK=true
# Строгий режим: остановить пайплайн если найдены ложные факты
FACT_CHECK_STRICT=false

# Fact Miner: ищет evidence per scene и даёт его ScenarioWriter'у
USE_FACT_MINER=true

# Postiz (для публикации)
POSTIZ_API_KEY=
POSTIZ_BASE_URL=https://api.postiz.com/public/v1
POSTIZ_TIKTOK_INTEGRATION_ID=
POSTIZ_INSTAGRAM_INTEGRATION_ID=
POSTIZ_YOUTUBE_INTEGRATION_ID=
POSTIZ_TELEGRAM_INTEGRATION_ID=

# YouTube Shorts напрямую (Google Cloud: включить YouTube Data API v3, OAuth client Web app)
# Положи скачанный JSON в credentials/youtube/ (несколько клиентов — разные имена файлов, путь в .env)
# В Authorized redirect URIs указать тот же URL, что и YOUTUBE_OAUTH_REDIRECT_URI
#
# Режим нескольких GCP-проектов / нескольких OAuth-клиентов: реестр JSON (пример: credentials/youtube/profiles.example.json).
# Каждый слот = свой client_secrets + свой файл токена. Если YOUTUBE_PROFILES_CONFIG задан и файл существует,
# пары client+token берутся только оттуда (YOUTUBE_OAUTH_CLIENT_SECRETS для слотов не используется).
# YOUTUBE_PROFILES_CONFIG=credentials/youtube/profiles.json
#
# Режим по умолчанию (два канала, один OAuth client в Console):
# YOUTUBE_OAUTH_CLIENT_SECRETS=credentials/youtube/client_secret_XXX.apps.googleusercontent.com.json
# YOUTUBE_OAUTH_TOKEN=youtube_token.json
# Второй канал: другой файл + второй OAuth (в UI выбор при заливке). Отключить: YOUTUBE_OAUTH_TOKEN_B=
# YOUTUBE_OAUTH_TOKEN=youtube_token.json
# YOUTUBE_OAUTH_TOKEN_B=youtube_token_channel2.json
# YOUTUBE_CHANNEL_PRIMARY_LABEL=@YourMainChannel
# YOUTUBE_CHANNEL_SECONDARY_LABEL=@OtherChannel
# Redirect в Google Console — URL бэкенда (uvicorn :8000), не Vite :5173:
# YOUTUBE_OAUTH_REDIRECT_URI=http://localhost:8000/api/youtube/oauth/callback
# После обновления кода: в OAuth запрашиваются upload + youtube.readonly — перелогинься
# («Канал 1/2» в Истории) или сбрось токены, иначе подсказки каналов в UI не подтянутся.
# FRONTEND_PUBLIC_URL=http://localhost:5173

# Планировщик (пик активности RU: вт-чт+сб в 19:00)
SCHEDULER_CRON=0 19 * * 2-4,6

# ── Видео-оверлеи ──────────────────────────────────────────────────────────────
# Водяной знак канала на всех сценах (пустая строка = отключено)
WATERMARK_TEXT=
# Звуковые эффекты (boom/whoosh/impact)
USE_SOUND_EFFECTS=true
USE_AI_MUSIC=true
AI_MUSIC_DURATION=15
# Сколько минут тематической базы генерировать перед лупом (по умолчанию 180s = 3 минуты)
AI_MUSIC_BASE_DURATION_SEC=180
# Длина одного куска генерации MusicGen (модель стабильно работает в районе 20-30s)
AI_MUSIC_SEGMENT_DURATION_SEC=30

# Пути
OUTPUT_DIR=output
MUSIC_DIR=music
SOUNDS_DIR=sounds

# ── Vite / фронт (VITE_* читаются из этого файла — см. frontend/vite.config envDir) ──
# VITE_API_URL=http://localhost:8000
# Пусто или закомментировано = относительные /api (прокси npm run dev → :8000).